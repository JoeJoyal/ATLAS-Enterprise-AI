# AWS Configuration
AWS_ACCESS_KEY_ID = "your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY = "your_aws_secret_access_key"
AWS_REGION = "ap-south-2"
S3_BUCKET = "your_s3_bucket_name"

# Bedrock Model Configuration
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0 
BEDROCK_CHAT_MODEL=moonshotai.kimi-k3
EMBED_DIM=1024

# Pinecone Vector Database Configuration
PINECONE_API_KEY="your_pinecone_api_key"
PINECONE_INDEX_HOST="atlas-enterprice-ai-index"
PINECONE_CLOUD=aws
PINECONE_REGION=ap-south-2
PINECONE_READY_TIMEOUT=180

# PostgreSQL Database Configuration
DATABASE_URL = your_postgresql_database_uri

# RIUS Observability Configuration
RIUS_API_KEY = "your_rius_api_key"
RIUS_SERVICE_NAME=atlas-ai-enterprice
RIUS_DISABLED=false
RIUS_CAPTURE_CONTENT=false